# Optional tuning
LCD_SAMPLE_SECONDS=2.0
LCD_JPEG_QUALITY=85

# Optional real-WAN startup gate. The LCD process waits for valid DNS/HTTPS
# before opening the panel so online stats populate on the first fetch.
LCD_WAN_CHECK_URL=https://www.gstatic.com/generate_204
LCD_WAN_RETRY_SECONDS=2

# Optional path to the LAN/WAN nftables counter cache (shared with the LCD project).
LCD_COUNTERS_PATH=/run/lcd-network-counters.json

# Optional external stats integrations.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCjMx6UPBC8NXfbhfiCIDIoA
TIKTOK_NEW_USERNAME=craigybabyj_new
TIKTOK_MAIN_USERNAME=craigybabyj
