[Unit]
Description=Thermalright Trofeo Vision LCD Stats Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=craig
Group=craig
WorkingDirectory=/home/craig/projects/lcd_therma
Environment=HOME=/home/craig
Environment=VIRTUAL_ENV=/home/craig/projects/lcd_therma/venv
Environment=PATH=/home/craig/projects/lcd_therma/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/craig/projects/lcd_therma/.env
ExecStart=/home/craig/projects/lcd_therma/venv/bin/python /home/craig/projects/lcd_therma/lcd_therma_stats.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/craig/projects/lcd_therma/lcd_therma.log
StandardError=append:/home/craig/projects/lcd_therma/lcd_therma.log

[Install]
WantedBy=multi-user.target
